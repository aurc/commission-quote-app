                  "pm.test(\"is UNAUTHENTICATED\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Entitled subject, scope not requested",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer}}"
              }
            ],
            "url": "{{middlewareUrl}}/v1/quotes",
            "description": "A valid token that does not ask for quote:generate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('scope', '');",
                  "// Mints the HS256 bearer the Middleware expects, so this folder can be run",
                  "// without the BFF. Same claims as contract.md section 7.",
                  "const key = pm.environment.get('signingKey');",
                  "const b64 = (obj) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)))",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "const now = Math.floor(Date.now() / 1000);",
                  "const header = b64({ alg: 'HS256', typ: 'JWT' });",
                  "const claims = b64({",
                  "  iss: 'cqapp-bff',",
                  "  aud: 'cqapp-middleware',",
                  "  sub: pm.environment.get('staffId'),",
                  "  // An empty scope is a real case, so it cannot fall through a || default:",
                  "  //   '' || 'quote:generate' is 'quote:generate', which is the opposite of the test.",
                  "  scope: (pm.environment.has('scope') ? pm.environment.get('scope') : 'quote:generate')",
                  "    .split(' ').filter(Boolean),",
                  "  iat: now,",
                  "  exp: now + 60,",
                  "  jti: 'postman-' + now,",
                  "});",
                  "",
                  "const signature = CryptoJS.HmacSHA256(header + '.' + claims, key);",
                  "const sig = CryptoJS.enc.Base64.stringify(signature)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "pm.environment.set('bearer', header + '.' + claims + '.' + sig);",
                  "pm.environment.unset('scope');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unentitled subject claiming the scope",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer}}"
              }
            ],
            "url": "{{middlewareUrl}}/v1/quotes",
            "description": "The test that matters. The token asks for the scope; the Middleware's own entitlement source does not grant it to this subject, so it is refused. A scope claim is a request, never a grant.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('staffId', pm.environment.get('unentitledStaffId'));",
                  "// Mints the HS256 bearer the Middleware expects, so this folder can be run",
                  "// without the BFF. Same claims as contract.md section 7.",
                  "const key = pm.environment.get('signingKey');",
                  "const b64 = (obj) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)))",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "const now = Math.floor(Date.now() / 1000);",
                  "const header = b64({ alg: 'HS256', typ: 'JWT' });",
                  "const claims = b64({",
                  "  iss: 'cqapp-bff',",
                  "  aud: 'cqapp-middleware',",
                  "  sub: pm.environment.get('staffId'),",
                  "  // An empty scope is a real case, so it cannot fall through a || default:",
                  "  //   '' || 'quote:generate' is 'quote:generate', which is the opposite of the test.",
                  "  scope: (pm.environment.has('scope') ? pm.environment.get('scope') : 'quote:generate')",
                  "    .split(' ').filter(Boolean),",
                  "  iat: now,",
                  "  exp: now + 60,",
                  "  jti: 'postman-' + now,",
                  "});",
                  "",
                  "const signature = CryptoJS.HmacSHA256(header + '.' + claims, key);",
                  "const sig = CryptoJS.enc.Base64.stringify(signature)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "pm.environment.set('bearer', header + '.' + claims + '.' + sig);",
                  "pm.environment.set('staffId', pm.environment.get('entitledStaffId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"is FORBIDDEN, not UNAUTHENTICATED\", () => {",
                  "  pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\");",
                  "});"
                ]
              }
            }
          ]
        },
