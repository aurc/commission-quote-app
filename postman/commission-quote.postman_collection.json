    {
      "name": "Middleware (internal)",
      "description": "The only component that holds the vendor credential and the only one that decides whether a caller may generate a quote.\n\nNot published by the default stack. Run `make up-debug` to reach it on 8082. Each request mints its own bearer in a pre-request script, so no BFF is needed.",
      "item": [
        {
          "name": "Generate a quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer}}"
              }
            ],
            "url": "{{middlewareUrl}}/v1/quotes",
            "description": "An entitled caller. 200, because this service creates and stores nothing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mints the HS256 bearer the Middleware expects, so this folder can be run",
                  "// without the BFF. Same claims as contract.md section 7.",
                  "const key = pm.environment.get('signingKey');",
                  "const b64 = (obj) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)))",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "const now = Math.floor(Date.now() / 1000);",
                  "const header = b64({ alg: 'HS256', typ: 'JWT' });",
                  "const claims = b64({",
                  "  iss: 'cqapp-bff',",
                  "  aud: 'cqapp-middleware',",
                  "  sub: pm.environment.get('staffId'),",
                  "  // An empty scope is a real case, so it cannot fall through a || default:",
                  "  //   '' || 'quote:generate' is 'quote:generate', which is the opposite of the test.",
                  "  scope: (pm.environment.has('scope') ? pm.environment.get('scope') : 'quote:generate')",
                  "    .split(' ').filter(Boolean),",
                  "  iat: now,",
                  "  exp: now + 60,",
                  "  jti: 'postman-' + now,",
                  "});",
                  "",
                  "const signature = CryptoJS.HmacSHA256(header + '.' + claims, key);",
                  "const sig = CryptoJS.enc.Base64.stringify(signature)",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "pm.environment.set('bearer', header + '.' + claims + '.' + sig);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "No bearer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{middlewareUrl}}/v1/quotes",
            "description": "Identity not established.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
