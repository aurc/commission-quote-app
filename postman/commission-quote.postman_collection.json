{
  "info": {
    "name": "Commission Quote App",
    "description": "Every endpoint in the system, one folder per component, so each API can be exercised on its own.\n\nThe default stack publishes only the Edge, so the Middleware and the vendor mock are not reachable from your machine. Run `make up-debug` to publish them on loopback for testing, or `make up` for the normal, closed configuration where only the BFF folder will work.\n\nRequests carry assertions, so `newman run` is a smoke test as well as a set of examples: `make smoke`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "BFF (browser facing)",
      "description": "What the front end talks to. Owns the staff session, exchanges it for a bearer the Middleware accepts, and writes the wording a person reads.\n\nPostman stores the session cookie automatically, so sign in once and the quote requests below work.",
      "item": [
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/session",
            "description": "Starts a session. The cookie is HttpOnly; Postman keeps it in its cookie jar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staffId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the staff member\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.staffId).to.eql(pm.environment.get(\"staffId\"));",
                  "  pm.expect(body.name).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/session",
            "description": "Who is signed in. 401 when the cookie is missing or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate a quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/v1/quotes",
            "description": "The whole path: session to bearer, Middleware, vendor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the vendor figures\", () => {",
                  "  const q = pm.response.json();",
                  "  pm.expect(q.quoteId).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(q.commissionRate).to.be.a(\"number\");",
                  "  pm.expect(q.totalCommission).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate a quote, every field invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/v1/quotes",
            "description": "Validation is authoritative in the Middleware and reports every failure at once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 1,\n  \"loanTermInMonths\": 9999,\n  \"riskBand\": \"Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"reports all three fields, not the first\", () => {",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql(\"VALIDATION_FAILED\");",
                  "  const fields = e.details.map((d) => d.field).sort();",
                  "  pm.expect(fields).to.eql([\"loanAmount\", \"loanTermInMonths\", \"riskBand\"]);",
                  "});",
                  "pm.test(\"carries a correlation id\", () => {",
                  "  pm.expect(pm.response.json().error.correlationId).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
