    {
      "name": "Vendor mock (not ours)",
      "description": "The stand in for the external Commission Quote API, deleted when the real one exists.\n\nNot published by the default stack. Run `make up-debug` to reach it on 8083. Note the vendor returns 201 and its own error shape: translating both is the Middleware's job.",
      "item": [
        {
          "name": "Generate a quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{vendorUrl}}/v1/quotes",
            "description": "201, because the vendor is modelled as recording what it issues.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"prices band B over 240 months at 1.80%\", () => {",
                  "  const q = pm.response.json();",
                  "  pm.expect(q.commissionRate).to.eql(0.018);",
                  "  pm.expect(q.totalCommission).to.eql(4500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing api-key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{vendorUrl}}/v1/quotes",
            "description": "Rejected with an empty body and no hint as to what was wrong.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"gives nothing away\", () => {",
                  "  pm.expect(pm.response.text()).to.be.empty;",
                  "  pm.expect(pm.response.headers.has(\"WWW-Authenticate\")).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong api-key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "api-key",
                "value": "not-the-key"
              }
            ],
            "url": "{{vendorUrl}}/v1/quotes",
            "description": "Indistinguishable from a missing key, deliberately.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 250000.0,\n  \"loanTermInMonths\": 240,\n  \"riskBand\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
