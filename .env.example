# Local development environment.
#
#   make env      copies this to .env
#   make run-...  loads .env automatically
#
# These are development values, not secrets. Nothing here is used anywhere but a
# laptop, and .env is gitignored so a real value never reaches the repository.
# In a deployed environment every value below comes from the secret manager,
# through the same SecretProvider interface.
#
# Reference: design/contract.md section 9.

# ---- Shared ----------------------------------------------------------------

# The vendor credential. Held by the Middleware, checked by the vendor, and
# never present in a browser or a BFF response.
CQAPI_API_KEY=local-dev-vendor-key-not-a-secret

# Verifies tokens the BFF mints for the Middleware. Must be at least 32 bytes:
# an HS256 key shorter than its own digest weakens the signature.
BFF_MIDDLEWARE_SIGNING_KEY=local-dev-signing-key-not-a-secret-0123456789

LOG_LEVEL=info

# Staff fixture, standing in for the IdP and the entitlement source. The BFF
# reads it for identity, the Middleware for scopes, so the two cannot disagree
# about who exists. Edit it and re-run; it is not a secret.
STAFF_FILE=config/staff.csv

# Unset means spans are created and propagated but not exported, which is the
# MVP default. No collector runs locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Service addresses -----------------------------------------------------
#
# Running natively, everything is on localhost. Under docker compose these are
# service names, and compose sets them itself.

CQAPI_BASE_URL=http://localhost:8083
MIDDLEWARE_BASE_URL=http://localhost:8082

# ---- Vendor simulation -----------------------------------------------------
#
# The challenge requires the vendor to fail occasionally. Turn these to 0 while
# working on something else, and back up to see the Middleware handle it.

CQAPI_FAILURE_RATE=0.15
CQAPI_SLOW_RATE=0.10
CQAPI_SLOW_MS=3000
CQAPI_LATENCY_MIN_MS=50
CQAPI_LATENCY_MAX_MS=400

# 0 seeds from the clock. Any other value makes the simulation reproducible,
# which is how the retry tests stay deterministic.
CQAPI_RANDOM_SEED=0

# ---- Ports -----------------------------------------------------------------
#
# PORT is per process, so it cannot live here for all three at once. Each run
# target sets its own; these are the defaults each service uses.
#
#   cqapi-mock        8083
#   cqapp-middleware  8082
#   cqapp-bff         8081
#   edge (nginx)      8080
