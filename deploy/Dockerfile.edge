# The front end and the Edge are one image: nginx serving the built SPA and
# routing /api to the BFF. They are a single deployable because the SPA is
# static files, and the thing that serves them is the thing that routes.

FROM node:22-alpine AS build
WORKDIR /src

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
# The published contract, for the test that asserts the front end's validation
# bounds match it.
COPY api/ ../api/
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/ /usr/share/nginx/html/
